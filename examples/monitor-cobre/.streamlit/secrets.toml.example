# Plantilla de secrets. NO subas el archivo real a GitHub.
# - Local: copia este archivo como .streamlit/secrets.toml
# - Streamlit Cloud: pega este contenido en  App → Settings → Secrets

# Clave que pedirá el tablero antes de mostrar datos. Usa una larga y difícil de adivinar.
clave_acceso = "CAMBIA-ESTA-CLAVE"

# Opcional: análisis de noticias con IA. Crea la clave en https://console.anthropic.com -> API Keys.
# Borra esta línea si no la vas a usar.
ANTHROPIC_API_KEY = "sk-ant-..."

# Tus valores reales (reemplazan a los estimados de config.yaml). Borra lo que no quieras cambiar.
[ajustes.empresa]
proveedor_actual = "peru"
inventario_toneladas = 120
consumo_mensual_toneladas = 80

[ajustes.proveedores.peru]
prima_usd_t = 120
flete_usd_t = 85
seguro_usd_t = 10

[ajustes.proveedores.chile]
prima_usd_t = 135
flete_usd_t = 110
seguro_usd_t = 10

[ajustes.proveedores.mexico]
prima_usd_t = 150
flete_usd_t = 140
seguro_usd_t = 12
